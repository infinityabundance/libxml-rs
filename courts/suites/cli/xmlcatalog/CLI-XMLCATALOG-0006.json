{
  "case_id": "CLI-XMLCATALOG-0006",
  "surface": "cli-xmlcatalog",
  "purpose": "--add system + public entries",
  "oracle_profile": "libxml2-2.15.3",
  "inputs": {
    "argv": [
      "--create",
      "@TMP@/cat.xml"
    ],
    "steps": [
      [
        "--create",
        "@TMP@/cat.xml"
      ],
      [
        "--noout",
        "--add",
        "system",
        "http://ex.org/a",
        "http://ex.org/a.xml",
        "@TMP@/cat.xml"
      ],
      [
        "--noout",
        "--add",
        "public",
        "-//OASIS//DTD X//EN",
        "http://ex.org/x.dtd",
        "@TMP@/cat.xml"
      ]
    ],
    "created_file": "@TMP@/cat.xml"
  },
  "observables": [
    "exit_status",
    "stdout_hash",
    "stderr_hash"
  ],
  "normalization": [],
  "provenance": [
    "upstream-documentation",
    "phase-10-differential-corpus"
  ],
  "tags": [
    "differential",
    "xmlcatalog"
  ]
}
