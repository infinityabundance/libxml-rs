{
 "case_id": "CLI-XMLLINT-0024",
 "surface": "cli-xmllint",
 "purpose": "--version identity output",
 "oracle_profile": "libxml2-2.15.3",
 "inputs": {
  "argv": [
   "--version"
  ]
 },
 "observables": [
  "exit_status",
  "stdout_hash",
  "stderr_hash"
 ],
 "normalization": [
  {
   "pattern": "/usr/bin/xmllint",
   "replacement": "TOOL"
  },
  {
   "pattern": "(?:/[A-Za-z0-9_./-]*)?target/debug/xmllint",
   "replacement": "TOOL"
  }
 ],
 "provenance": [
  "upstream-documentation",
  "phase-10-differential-corpus"
 ],
 "tags": [
  "differential",
  "xmllint"
 ]
}
