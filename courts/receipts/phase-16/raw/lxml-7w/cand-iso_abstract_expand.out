<?xml version="1.0"?>
<sch:schema xmlns:sch="http://purl.oclc.org/dsdl/schematron">
  <sch:title>iso schematron validation</sch:title>
  <sch:ns uri="http://www.w3.org/2001/XMLSchema-instance" prefix="xsi"/>
  <!--Suppressed abstract pattern abstract.dateTime.tz_utc was here-->
  <!--Start pattern based on abstract abstract.dateTime.tz_utc--><sch:pattern id="datetime">
    <sch:rule context="datetime">
      <sch:let name="lastchar" value="substring(./text(), string-length(./text()))"/>
      <sch:assert test="$lastchar='Z'">[ERROR] <sch:value-of select="name(.)"/></sch:assert>
    </sch:rule>
  </sch:pattern>
</sch:schema>

