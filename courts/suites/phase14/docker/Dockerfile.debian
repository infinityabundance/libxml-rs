# syntax=docker/dockerfile:1
#
# Phase 14 — Downstream Custodian Validation: minimal Debian court image.
#
# FROM the minimal Docker Hub `debian:bookworm` base. Inside:
#   /usr/local        canonical oracle libxml2 2.15.3 + libxslt 1.1.45 +
#                     libexslt 0.8.25 (ICU+Iconv, pinned source, sha256-verified)
#   /src              pinned consumer sources (lxml tag, nokogiri tag, php tarball)
#   /court/consumers  in-container court runners (mode: oracle | candidate)
#
# The candidate run mounts the host `target/debug` read-only at /candidate and
# the runner overrides pkg-config/LD paths; nothing consumer-side changes.
#
# Build (context = repository root):
#   docker build -t libxml-rs/phase14-debian:1 \
#     -f courts/suites/phase14/docker/Dockerfile.debian .
FROM debian:bookworm

ENV DEBIAN_FRONTEND=noninteractive TZ=UTC LANG=C.UTF-8 LC_ALL=C.UTF-8

# toolchain + consumer runtimes (pinned by bookworm release)
RUN apt-get update && apt-get install -y --no-install-recommends \
    build-essential pkg-config curl ca-certificates xz-utils file \
    zlib1g-dev liblzma-dev libicu-dev \
    python3-dev python3-pip \
    ruby ruby-dev rake \
    bison re2c autoconf libtool gdb \
    && rm -rf /var/lib/apt/lists/*

# test-runner deps (same for oracle and candidate runs)
RUN python3 -m pip install --no-cache-dir --break-system-packages pytest cssselect cython html5lib \
    && gem install --no-document minitest rake

# ── canonical oracle: libxml2 2.15.3 + libxslt 1.1.45 (ICU+Iconv) ──────────
ARG LIBXML2_VERSION=2.15.3
ARG LIBSXLT_VERSION=1.1.45
ARG LIBXML2_SHA256=78262a6e7ac170d6528ebfe2efccdf220191a5af6a6cd61ea4a9a9a5042c7a07
ARG LIBSXLT_SHA256=9acfe68419c4d06a45c550321b3212762d92f41465062ca4ea19e632ee5d216e
WORKDIR /oracle
COPY oracle/build.sh /oracle/build.sh
RUN chmod +x /oracle/build.sh \
    && curl -fsSL -o libxml2.tar.xz \
       "https://download.gnome.org/sources/libxml2/${LIBXML2_VERSION%.*}/libxml2-${LIBXML2_VERSION}.tar.xz" \
    && curl -fsSL -o libxslt.tar.xz \
       "https://download.gnome.org/sources/libxslt/${LIBSXLT_VERSION%.*}/libxslt-${LIBSXLT_VERSION}.tar.xz" \
    && echo "${LIBXML2_SHA256}  libxml2.tar.xz" | sha256sum -c - \
    && echo "${LIBSXLT_SHA256}  libxslt.tar.xz" | sha256sum -c - \
    && tar xf libxml2.tar.xz && tar xf libxslt.tar.xz \
    && rm -f libxml2.tar.xz libxslt.tar.xz \
    && /oracle/build.sh "${LIBXML2_VERSION}" "${LIBSXLT_VERSION}" \
    && /usr/local/bin/xmllint --version 2>&1 | head -1

# ── consumer sources + court runners ────────────────────────────────────────
COPY courts/suites/phase14/sources /src
COPY courts/suites/phase14/consumers /court/consumers
RUN chmod +x /court/consumers/*.sh && mkdir -p /out
CMD ["/bin/bash"]
